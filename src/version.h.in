// Single source of version number (generated by CMake configure_file; do not edit manually)
// Naming scheme: baseline panicast_V0.0.1
//   - Fix line:   panicast_V0.0.1-F01..-F99  (bug fixes, parallel)
//   - Y line:     panicast_V0.0.1-Y01..-Y99  (multi-account / Google-login feature line, parallel to F)
// To change the version, edit PANICAST_VERSION_TAG at the top of CMakeLists.txt
#ifndef PANICAST_VERSION_H
#define PANICAST_VERSION_H

#define PANICAST_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@
#define PANICAST_VERSION_MINOR  @PROJECT_VERSION_MINOR@
#define PANICAST_VERSION_PATCH  @PROJECT_VERSION_PATCH@
#define PANICAST_FIX_SUFFIX     "@PANICAST_FIX_SUFFIX@"
// Version alone (e.g. V0.0.1) — program name is a separate field.
#define PANICAST_VERSION_STRING "@PANICAST_VERSION_TAG@"
// Product string: program name + version (e.g. panicast-V0.0.1).
#define PANICAST_FULL_VERSION  "@PANICAST_FULL_VERSION@"

#endif // PANICAST_VERSION_H
